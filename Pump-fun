        "positions": {},       # mint -> {"amount": tokens, "avg_price_sol": price}
        "closed_trades": [],   # ιστορικό κλειστών θέσεων
        "last_signature": None,
    }

def save_state():
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)

state = load_state()

